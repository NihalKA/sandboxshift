# Python
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Security — NEVER commit these
.env
*.pem
*.key
*.p12
.aws/
secrets.yaml
*secret*
*credentials*
settings.json

# Terraform state — contains sensitive data (ARNs, resource IDs)
# ** glob matches terraform/fargate/ and any nested directory
**/.terraform/
**/*.tfstate
**/*.tfstate.backup
**/*.tfstate.*.backup
**/.terraform.lock.hcl

# backend.tf is generated at runtime by sandboxshift-setup.sh.
# It contains your AWS account-specific bucket and DynamoDB table names.
# See terraform/fargate/backend.tf.example for the template.
terraform/fargate/backend.tf

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# SandboxShift runtime output
.sandboxshift/
sandbox-sessions/
audit-logs/

# Keep these (source controlled)
!.github/agents/
!.github/ISSUE_TEMPLATE/
!.github/pull_request_template.md
