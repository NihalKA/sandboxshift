# .env.example — copy to .env and fill in real values
#
# SandboxShift blocks .env uploads to S3 by default (Security Layer 6).
# To allow a specific .env file for a cloud run, use:
#
#   CLI:   sandboxshift run . "node dist/main.js" --mode cloud --allow-file .env
#   YAML:  workspace:
#            upload_allow:
#              - .env
#
# Every file explicitly allowed past the sensitive filter is recorded in
# the audit log under "upload_allowed_sensitive".

NODE_ENV=production
PORT=3000
API_KEY=your-api-key-here
DATABASE_URL=postgres://user:password@localhost:5432/mydb
